<Window x:Class="EverythingImages.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EverythingImages"
        Title="EverythingImages" Icon="app.ico" Width="1360" Height="860" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Page}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{StaticResource Ink}">
    <Window.Resources>
        <local:ShowIfSet x:Key="Show" />
        <local:Invert x:Key="Not" />
        <local:PathToImage x:Key="Preview" />

        <!-- Gradient progress used for describing (cards, preview) -->
        <Style x:Key="AiBar" TargetType="ProgressBar">
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#55000000" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource AiGradient}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="#F1F3F7" />
        </Style>

        <!-- Plain container, no ListBox selection chrome: selection is ours -->
        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One image card -->
        <DataTemplate x:Key="Card" DataType="{x:Type local:ImageItem}">
            <Button Margin="0,0,12,12" Click="Card_Click" MouseDoubleClick="Card_DoubleClick" Cursor="Hand"
                    AutomationProperties.Name="{Binding Filename}"
                    Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Button.Template>
                <Border x:Name="card" Background="White" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Line}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Height="{Binding DataContext.CardImageHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                              Background="{Binding Swatch}" ClipToBounds="True">
                            <Grid.Clip>
                                <RectangleGeometry RadiusX="9" RadiusY="9" Rect="0,0,2000,2000" />
                            </Grid.Clip>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border Style="{StaticResource Pill}" Background="#CC111111" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,8"
                                    Visibility="{Binding HasOcr, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="📄 OCR" Foreground="White" FontSize="10.5" FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="#D94F46E5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,8"
                                    Visibility="{Binding HasAi, Converter={StaticResource BoolToVis}}" ToolTip="{Binding AiText}">
                                <TextBlock Text="✨ AI" Foreground="White" FontSize="10.5" FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="#E64F46E5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Live.Label}">
                                <TextBlock Text="{Binding LivePercent}" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                            </Border>
                            <ProgressBar Style="{StaticResource AiBar}" VerticalAlignment="Bottom" Value="{Binding Live.Fraction, Mode=OneWay}"
                                         Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="10,7,10,8">
                            <TextBlock Text="{Binding Filename}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="11" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Dimensions}" FontSize="11" Foreground="{StaticResource Muted}" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Brand}" />
                    <Setter TargetName="card" Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="#6366F1" />
                    <Setter TargetName="card" Property="BorderThickness" Value="2" />
                    <Setter TargetName="card" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#6366F1" BlurRadius="14" ShadowDepth="0" Opacity="0.45" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="◈" FontSize="26" Foreground="{StaticResource Brand}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="Bold"><Run Text="Chroma" /><Run Text="Scan" Foreground="{StaticResource Brand}" /></TextBlock>
                        <TextBlock Text="INSTANT LOCAL IMAGE SEARCH" FontSize="9" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Click="Folders_Click" Margin="12,0,0,0" ToolTip="Folders EverythingImages scans" AutomationProperties.Name="Folders">
                        <TextBlock><Run Text="🗀 Folders  " /><Run Text="{Binding FolderCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Brand}" /></TextBlock>
                    </Button>
                    <Button Click="Scan_Click" Margin="8,0,0,0" IsEnabled="{Binding CanScan}" AutomationProperties.Name="{Binding ScanButtonLabel}"
                            ToolTip="Look through your folders for new, changed and deleted images">
                        <TextBlock Text="{Binding ScanButtonLabel, StringFormat='⟳ {0}'}" />
                    </Button>
                    <Button Click="DescribeAll_Click" Margin="8,0,0,0" IsEnabled="{Binding CanScan}" ToolTip="{Binding DescribeAllTip}" AutomationProperties.Name="{Binding DescribeAllLabel}">
                        <TextBlock Text="{Binding DescribeAllLabel, StringFormat='✨ {0}'}" />
                    </Button>
                    <Button Click="Options_Click" Margin="8,0,0,0" Content="⚙ Options" ToolTip="GPU or CPU, AI models, the description prompt, OCR" />
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                        <RadioButton Style="{StaticResource Chip}" GroupName="view" IsChecked="True" Checked="GridView_Checked" Content="▦" ToolTip="Grid" Margin="0,0,4,0" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="view" Checked="ListView_Checked" Content="☰" ToolTip="List" Margin="0" />
                    </StackPanel>
                </StackPanel>
                <Grid Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,30,7"
                             AutomationProperties.Name="Search" />
                    <TextBlock Text="🔍" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="Search filenames, text in images, colours, AI descriptions...   ( / )" Margin="32,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="#9CA3AF"
                               Visibility="{Binding Query, Converter={StaticResource Show}, ConverterParameter=invert}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Filters, size, sort -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="SizePanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Size:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="size" Content="S" Tag="Small" Checked="Size_Checked" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="size" Content="M" Tag="Medium" Checked="Size_Checked" IsChecked="True" />
                        <RadioButton Style="{StaticResource Chip}" GroupName="size" Content="L" Tag="Large" Checked="Size_Checked" Margin="0,0,14,0" />
                    </StackPanel>
                    <TextBlock Text="Sort:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="170" ItemsSource="{Binding SortOptions}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding SortKey}" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Chip}" GroupName="quick" Tag="All" Content="All items" IsChecked="True" Checked="Quick_Checked" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="quick" Tag="Ocr" Content="Has text" Checked="Quick_Checked" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="quick" Tag="Landscape" Content="Landscape" Checked="Quick_Checked" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="quick" Tag="Portrait" Content="Portrait" Checked="Quick_Checked" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="quick" Tag="Png" Content="PNG" Checked="Quick_Checked" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="quick" Tag="Jpg" Content="JPG" Checked="Quick_Checked" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="quick" Tag="Webp" Content="WebP" Checked="Quick_Checked" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Progress banner: a scan the user asked for, or Describe all -->
        <Border Grid.Row="2" Background="#E6EDFF" Visibility="{Binding BannerVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="16,8,12,6">
                    <Button DockPanel.Dock="Right" Content="Stop" Click="StopBanner_Click" Margin="12,0,0,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding BannerCount}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="{Binding BannerTitle}" FontWeight="Bold" />
                        <TextBlock x:Name="BannerDetailText" Text="{Binding BannerDetail}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </DockPanel>
                <ProgressBar Height="3" Maximum="1" Value="{Binding BannerFraction, Mode=OneWay}" IsIndeterminate="{Binding BannerIndeterminate, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- Results + inspector -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Grid view: a virtualized list of rows of cards -->
            <ListBox x:Name="GridList" ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource PlainItem}"
                     Background="Transparent" BorderThickness="0" Padding="14,14,0,0"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SizeChanged="GridList_SizeChanged" AutomationProperties.Name="Images">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ImageRow}">
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Card}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- List view -->
            <ListBox x:Name="ListList" ItemsSource="{Binding Items}" Visibility="Collapsed" BorderThickness="0" Background="Transparent"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionChanged="ListList_SelectionChanged" MouseDoubleClick="ListList_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ImageItem}">
                        <DockPanel Margin="4,3">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Width="70" TextAlignment="Right" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Dimensions}" Width="90" FontSize="12" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Left" Width="56" Height="40" CornerRadius="4" Background="{Binding Swatch}" Margin="0,0,10,0">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Filename}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ListLine}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="🖼" FontSize="48" HorizontalAlignment="Center" Foreground="#C0C6D0" />
                <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,8,0,4"
                           Text="{Binding NoFolders, Converter={x:Static local:MainWindow.EmptyTitle}}" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource MutedText}"
                           Text="{Binding NoFolders, Converter={x:Static local:MainWindow.EmptyHint}}" />
                <Button Style="{StaticResource Primary}" Content="Add a folder" Click="Folders_Click" Margin="0,14,0,0" HorizontalAlignment="Center"
                        Visibility="{Binding NoFolders, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- Inspector -->
            <Border Grid.Column="1" Width="360" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"
                    Visibility="{Binding Selected, Converter={StaticResource Show}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,8,6,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="✕" Click="CloseInspector_Click" ToolTip="Close" />
                        <TextBlock Text="Image Inspector" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,0,16,16">
                            <Grid>
                                <Border CornerRadius="8" Background="{Binding Selected.Swatch}" Height="220" ClipToBounds="True">
                                    <Image Source="{Binding Selected.Record.Path, Converter={StaticResource Preview}, ConverterParameter=700}" Stretch="Uniform" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="8" VerticalAlignment="Top">
                                    <Border Style="{StaticResource Pill}" Margin="0,0,4,0"><TextBlock Text="{Binding Selected.Record.Extension, StringFormat='.{0}'}" FontSize="10.5" /></Border>
                                    <Border Style="{StaticResource Pill}" Margin="0,0,4,0"><TextBlock Text="{Binding Selected.Dimensions}" FontSize="10.5" /></Border>
                                    <Border Style="{StaticResource Pill}"><TextBlock Text="{Binding Selected.SizeText}" FontSize="10.5" /></Border>
                                </StackPanel>
                                <ProgressBar Style="{StaticResource AiBar}" Height="5" VerticalAlignment="Bottom" Value="{Binding SelectedLive.Fraction, Mode=OneWay}"
                                             Visibility="{Binding SelectedBusy, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <Button Content="↗ Open" Margin="0,0,4,0" Click="OpenSelected_Click" />
                                <Button Content="🗀 Show in folder" Margin="4,0,0,0" Click="RevealSelected_Click" />
                            </UniformGrid>

                            <!-- AI description -->
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource AiSoft}" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                        Visibility="{Binding ModelChip, Converter={StaticResource Show}}">
                                    <TextBlock Text="{Binding ModelChip}" Foreground="{StaticResource Ai}" FontSize="10.5" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="AI DESCRIPTION" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                            <Button Content="{Binding DescribeButtonLabel}" Click="DescribeSelected_Click" IsEnabled="{Binding SelectedBusy, Converter={StaticResource Not}}" />
                            <Border Margin="0,8,0,0" Padding="10" CornerRadius="8" Background="#F5F5FF" BorderBrush="#C7C9F9" BorderThickness="1"
                                    Visibility="{Binding SelectedBusy, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedLive.Label, StringFormat='{}{0}...'}" Style="{StaticResource MutedText}" FontSize="11" />
                                    <TextBlock TextWrapping="Wrap" FontWeight="Medium" Margin="0,4,0,0"><Run Text="{Binding SelectedLive.Text, Mode=OneWay}" /><Run Text="▍" Foreground="#6366F1" /></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,8,0,0" Padding="10" CornerRadius="8" Background="#FDECEC"
                                    Visibility="{Binding SelectedError, Converter={StaticResource Show}}">
                                <TextBlock Text="{Binding SelectedError}" TextWrapping="Wrap" Foreground="{StaticResource Bad}" />
                            </Border>
                            <Border Margin="0,8,0,0" Padding="10" CornerRadius="8" Background="{StaticResource Page}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    Visibility="{Binding SelectedCaption, Converter={StaticResource Show}}">
                                <StackPanel>
                                    <TextBox Text="{Binding SelectedCaption, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                             TextWrapping="Wrap" FontWeight="Medium" />
                                    <TextBlock Text="{Binding SelectedMeta}" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Palette -->
                            <TextBlock Text="COLOUR PALETTE" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding SelectedColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ColorChip}">
                                        <Button Margin="0,0,6,6" Padding="4,3,8,3" Tag="{Binding Hex}" Click="CopyColor_Click" ToolTip="{Binding Hex, StringFormat='Copy {0}'}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="16" Height="16" CornerRadius="3" Background="{Binding Brush}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Label}" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- OCR text -->
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Copy" Click="CopyText_Click" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                <TextBlock Text="TEXT IN THE IMAGE" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                            <TextBox x:Name="OcrBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                     Background="{StaticResource Page}" Text="{Binding Selected.Record.OcrText, Mode=OneWay}" />

                            <!-- File -->
                            <TextBlock Text="FILE" Style="{StaticResource SectionTitle}" />
                            <TextBox Text="{Binding Selected.Record.Path, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="{Binding Selected.Record.Modified, StringFormat='Modified {0:yyyy-MM-dd HH:mm}'}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Toast -->
            <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" MaxWidth="620"
                    Background="#1F2937" CornerRadius="8" Padding="16,10" Visibility="{Binding Toast, Converter={StaticResource Show}}">
                <TextBlock Text="{Binding Toast}" Foreground="White" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding OcrFooter}" Style="{StaticResource MutedText}" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding ResultCount, StringFormat='{}{0} items'}" />
                    <TextBlock Text="  |  " Foreground="#C0C6D0" />
                    <TextBlock FontSize="12" Text="{Binding SearchMs, StringFormat='{}{0:0.00} ms'}" />
                    <TextBlock Text="  |  " Foreground="#C0C6D0" />
                    <TextBlock FontSize="12" Text="{Binding FolderText}" />
                </StackPanel>
                <TextBlock Text="{Binding FooterStatus}" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource Good}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
