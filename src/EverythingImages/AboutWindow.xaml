<Window x:Class="EverythingImages.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About EverythingImages" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="White" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <StackPanel Margin="28,24,28,20">
        <Image Source="app.ico" Width="64" Height="64" HorizontalAlignment="Center" />
        <TextBlock FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Run Text="Everything" /><Run Text="Images" Foreground="{StaticResource Brand}" />
        </TextBlock>
        <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,2,0,0" />
        <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,0"
                   Text="Instant local image search: filenames, text in images, colours and AI descriptions. Everything stays on this PC." />

        <!-- The shared signature block (Signature.cs, copied from the About folder every app uses). -->
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Margin="0,18,0,0" Padding="0,16,0,16">
            <StackPanel>
                <TextBlock x:Name="TamilText" FontSize="16" TextAlignment="Center" Foreground="{StaticResource Ink}" />
                <TextBlock x:Name="MeaningText" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0" FontStyle="Italic" />
                <TextBlock x:Name="CreditText" TextAlignment="Center" Margin="0,12,0,0" />
                <Button x:Name="SiteButton" Style="{StaticResource Link}" HorizontalAlignment="Center" Click="Site_Click" />
            </StackPanel>
        </Border>

        <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Style="{StaticResource Link}" Content="GitHub page" Click="GitHub_Click" ToolTip="Source code and downloads" />
            <Button Style="{StaticResource Link}" Content="Report a problem" Click="Issues_Click" />
            <Button Style="{StaticResource Link}" Content="MIT License" Click="License_Click" />
        </WrapPanel>

        <Button Style="{StaticResource Primary}" Content="Close" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
                Margin="0,14,0,0" Click="Close_Click" />
    </StackPanel>
</Window>
