<Window x:Class="EverythingImages.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Width="820" Height="780" WindowStartupLocation="CenterOwner"
        Background="White" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Done" Click="Done_Click" />
                <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                           Text="OCR and AI run on this PC; your images never leave it. Downloads come from huggingface.co and github.com." />
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,16,22,20">
                <TextBlock Text="Options" FontSize="18" FontWeight="Bold" />

                <!-- OCR -->
                <TextBlock Text="🔤  Text in images (OCR)" FontWeight="Bold" FontSize="14" Margin="0,18,0,2" />
                <TextBlock Style="{StaticResource MutedText}" Text="Windows' built-in OCR reads text in screenshots, receipts and documents while scanning." />
                <CheckBox x:Name="OcrCheck" Content="Read text in images (off makes scanning faster; images already scanned keep their text)"
                          Margin="0,8,0,0" Checked="Ocr_Changed" Unchecked="Ocr_Changed" />

                <!-- GPU / CPU -->
                <TextBlock Text="🖥  Run AI models on" FontWeight="Bold" FontSize="14" Margin="0,22,0,2" />
                <TextBlock Style="{StaticResource MutedText}" Text="The graphics card is much faster; the processor works on any PC." />
                <UniformGrid x:Name="ProcessorPanel" Columns="2" Margin="0,8,0,0" />

                <!-- Models -->
                <DockPanel Margin="0,22,0,2">
                    <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="⟳ Refresh" Click="Refresh_Click" ToolTip="Check Hugging Face for new models" />
                    <StackPanel>
                        <TextBlock Text="⚡  Liquid AI vision models" FontWeight="Bold" FontSize="14" />
                        <TextBlock x:Name="ModelsNote" Style="{StaticResource MutedText}" Text="Small vision-language models from Hugging Face, stored on this PC." />
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="ModelsPanel" Margin="0,8,0,0" />

                <!-- Prompt -->
                <TextBlock Text="✍  Description prompt" FontWeight="Bold" FontSize="14" Margin="0,22,0,2" />
                <TextBlock Style="{StaticResource MutedText}" Text="What the AI is asked about every image. Change it for longer descriptions, keywords, another language, or anything else." />
                <WrapPanel x:Name="PresetPanel" Margin="0,8,0,6">
                    <TextBlock Text="Start from:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                </WrapPanel>
                <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" TextChanged="Prompt_Changed" AutomationProperties.Name="Description prompt" />
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" x:Name="SaveButton" Style="{StaticResource Primary}" Content="Save prompt" Click="SavePrompt_Click" Margin="6,0,0,0" />
                    <Button DockPanel.Dock="Right" x:Name="ResetButton" Style="{StaticResource Ghost}" Content="Reset to default" Click="ResetPrompt_Click" />
                    <TextBlock x:Name="PromptStatus" VerticalAlignment="Center" FontSize="12" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="A saved prompt is used for images described from then on." />
                    <Button Style="{StaticResource Link}" Content="Redo all images with the saved prompt" Click="RedoAll_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
